{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "command-event.v1.schema.json",
  "title": "CommandEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "timestamp", "command", "source"],
  "properties": {
    "schema_version": {"const": "command-event.v1"},
    "event_id": {"type": "string", "minLength": 1},
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "command": {"type": "string", "minLength": 1},
    "cwd": {"type": "string", "minLength": 1},
    "source": {
      "enum": ["synthetic", "historical-redacted", "generated-variant"]
    }
  }
}
