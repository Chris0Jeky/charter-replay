{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "policy-decision.v1.schema.json",
  "title": "PolicyDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "effect", "reason"],
  "properties": {
    "schema_version": {"const": "policy-decision.v1"},
    "event_id": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "[\\uD800-\\uDFFF]"}
    },
    "effect": {"enum": ["allow", "deny", "indeterminate"]},
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "not": {"pattern": "[\\r\\n\\uD800-\\uDFFF]"}
    }
  }
}
